GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
GOOGLE_ADS_CLIENT_ID=your_google_oauth_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_oauth_refresh_token

# Primary provider. Available values: moonshot, openai, gemini, kimi-code.
LLM_PROVIDER=moonshot

# Moonshot/Kimi API (primary). Keep the real key only in .env or the deployment secret store.
MOONSHOT_API_KEY=your_moonshot_api_key
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2.6
MOONSHOT_THINKING=enabled

# Existing OpenAI provider remains available with LLM_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna

# Existing Gemini provider remains available with LLM_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Existing Kimi coding endpoint remains available with LLM_PROVIDER=kimi-code.
KIMI_API_KEY=your_kimi_coding_api_key
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=kimi-for-coding

LLM_BATCH_SIZE=50
GOOGLE_FETCH_CONCURRENCY=5
LLM_CONCURRENCY=3
LLM_REQUEST_TIMEOUT_MS=600000
LLM_MAX_ATTEMPTS=5
RUN_TIME_ZONE=Europe/Moscow

# One Excel workbook per run, sent through Resend with one worksheet per organization.
RUN_REPORT_EMAIL_ENABLED=true
RUN_REPORT_EMAIL_TO=aliamin588@gmail.com
RUN_REPORT_EMAIL_FROM=Negative Keyword Sweeper <sweeper@your-verified-domain.example>
RUN_REPORT_EMAIL_SUBJECT_PREFIX=[Negative Keyword Sweeper]
RESEND_API_KEY=your_resend_api_key
RESEND_REQUEST_TIMEOUT_MS=60000
RESEND_MAX_ATTEMPTS=5

# Structured terminal logging: trace, debug, info, warn, error, fatal, or silent.
LOG_LEVEL=info

# SMTP error alerts. Keep disabled until the values below are configured.
ERROR_EMAIL_ENABLED=false
ERROR_EMAIL_TO=operations@example.com
ERROR_EMAIL_FROM=negative-keyword-sweeper@example.com
ERROR_EMAIL_SUBJECT_PREFIX=[Negative Keyword Sweeper]
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Optional comma-separated policy for handled errors. Empty means unhandled errors only.
# Use * for every handled error, or configure exact structured codes/stages later.
ALERT_HANDLED_ERROR_CODES=
ALERT_HANDLED_ERROR_STAGES=
